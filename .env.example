# 对外访问端口（前端 Nginx），默认 9527
WEB_PORT=9527

# JWT 签名密钥（生产环境务必修改为随机字符串）
# 生成示例：python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=hotel-training-system-secret-key-change-me

# 支付网关签名密钥（酒店后端与模拟网关共享，务必与 SECRET_KEY 不同）
PAY_SECRET=demo-pay-secret-change-me

# 超时自动退房：预计离店日退房时限（默认 12 点）后宽限的小时数，超期未退房由系统自动退房
AUTO_CHECKOUT_ENABLED=true
AUTO_CHECKOUT_CHECKOUT_HOUR=12
AUTO_CHECKOUT_GRACE_HOURS=2
AUTO_CHECKOUT_INTERVAL_SECONDS=60

